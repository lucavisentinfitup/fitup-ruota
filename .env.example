# --- Auth.js (backend /admin) ---
# Genera con: npx auth secret   (oppure openssl rand -base64 32)
AUTH_SECRET=
# Google Cloud Console > Credenziali > ID client OAuth (tipo "Applicazione web")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Solo gli account Google Workspace di questo dominio possono accedere al backend
ALLOWED_DOMAIN=fitup.it

# --- Database (Neon Postgres, aggiunto da Vercel > Storage) ---
DATABASE_URL=

# --- Upload immagini (Vercel Blob, aggiunto da Vercel > Storage) ---
BLOB_READ_WRITE_TOKEN=

# --- Solo sviluppo locale: entra in /admin senza Google (ignorato in produzione) ---
# DEV_ADMIN_BYPASS=1

# --- Realtime per gli schermi TV (facoltativo ma consigliato in produzione) ---
# Chiave API Ably (ably.com, piano gratuito fino a 200 connessioni contemporanee).
# Senza chiave le TV ricevono gli eventi in polling (funziona, ma genera più richieste).
ABLY_API_KEY=
